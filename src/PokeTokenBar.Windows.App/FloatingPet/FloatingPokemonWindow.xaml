<Window x:Class="PokeTokenBar.Windows.App.FloatingPet.FloatingPokemonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sprites="clr-namespace:PokeTokenBar.Windows.App.Sprites"
        Title="PokeTokenBar Floating Pet"
        Width="{Binding Size, Mode=OneWay}"
        Height="{Binding Size, Mode=OneWay}"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Background="Transparent" ToolTip="{Binding HoverText, Mode=OneWay}">
        <Popup Placement="Top"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="{Binding IsBubbleVisible, Mode=OneWay}">
            <Border Width="180" Margin="4" Padding="9"
                    CornerRadius="10"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding BubbleTitle, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding BubbleBody, Mode=OneWay}"
                               FontSize="10" TextWrapping="Wrap" MaxHeight="32" />
                </StackPanel>
            </Border>
        </Popup>
        <TextBlock Text="&#x1F95A;"
                   FontSize="60"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sprite, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <sprites:AnimatedSpritePresenter x:Name="FloatingSprite"
                                          Presentation="{Binding Sprite, Mode=OneWay}"
                                          MinimumFrameDuration="{Binding MinimumFrameDuration, Mode=OneWay}"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
</Window>
