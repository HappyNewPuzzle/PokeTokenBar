<Window x:Class="PokeTokenBar.Windows.App.FloatingPet.FloatingPokemonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sprites="clr-namespace:PokeTokenBar.Windows.App.Sprites"
        Title="PokeTokenBar Floating Pet"
        Width="96"
        Height="96"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Background="Transparent">
        <TextBlock Text="&#x1F95A;"
                   FontSize="60"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sprite, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <sprites:AnimatedSpritePresenter x:Name="FloatingSprite"
                                          Presentation="{Binding Sprite, Mode=OneWay}"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
</Window>
