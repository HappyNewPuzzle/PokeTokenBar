<Window x:Class="PokeTokenBar.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sprites="clr-namespace:PokeTokenBar.Windows.App.Sprites"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PokeTokenBar"
        Width="520"
        Height="760"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True">
    <TabControl>
        <TabItem Header="{Binding Texts.Home, Mode=OneWay}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="84" Height="84" VerticalAlignment="Top">
                        <TextBlock Text="🥚"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Companion.CompanionSprite, Mode=OneWay}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <sprites:AnimatedSpritePresenter x:Name="CompanionSprite"
                                                          Presentation="{Binding Companion.CompanionSprite, Mode=OneWay}"
                                                          RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Texts.Companion, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Companion.DisplayName, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="5,0,0,0" Text="✨" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Companion.CurrentIsShiny, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Companion.RarityText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="6,0,0,0"
                                       Text="{Binding Companion.Personality, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Companion.StageText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <ProgressBar Margin="0,6,0,0"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding Companion.Progress, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Companion.ProgressText, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding Companion.StatusText, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding Companion.HatchingText, Mode=OneWay}"
                                   FontSize="10"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Companion.IsHatching, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PokeTokenBar"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Usage.ProviderName, Mode=OneWay, TargetNullValue=No usage data}"
                               Margin="0,6,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                        <Run Text="Last updated: " />
                        <Run Text="{Binding Usage.LastUpdatedText, Mode=OneWay, TargetNullValue=—}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="104"
                        Height="34"
                        Padding="14,4"
                        VerticalAlignment="Top"
                        Command="{Binding Usage.RefreshCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Refresh" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Usage.IsRefreshing, Mode=OneWay}" Value="True">
                                    <Setter Property="Content" Value="Refreshing…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ComboBox Grid.Row="2"
                      Margin="0,20,0,0"
                      ItemsSource="{Binding Usage.Providers, Mode=OneWay}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="ProviderId"
                      SelectedValue="{Binding Usage.SelectedProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Usage.Providers.Count, Mode=OneWay}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Usage.Providers.Count, Mode=OneWay}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <Border Grid.Row="3"
                    Margin="0,20,0,0"
                    Padding="20"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Texts.Today, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Usage.TodayTokensText, Mode=OneWay, TargetNullValue=—}"
                                   FontSize="34"
                                   FontWeight="Bold" />
                        <TextBlock Margin="12,12,0,0"
                                   Text="{Binding Usage.TodayTokensGroupedText, Mode=OneWay}"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <TextBlock Margin="12,12,0,0"
                                   Text="{Binding Usage.TodayCostText, Mode=OneWay}"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Texts.Input, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.InputTokensText, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Texts.Output, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.OutputTokensText, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cache write" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.CacheWriteTokensText, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Cache read" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.CacheReadTokensText, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="20"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Usage periods" FontSize="14" FontWeight="SemiBold" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Texts.RecentFiveHours, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.RecentFiveHourTokensText, Mode=OneWay, TargetNullValue=—}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Texts.ThisWeek, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.WeekTokensText, Mode=OneWay, TargetNullValue=—}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Texts.ThisMonth, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Usage.MonthTokensText, Mode=OneWay, TargetNullValue=—}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="5"
                    Margin="0,16,0,0"
                    Padding="20"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Usage.HasCodexRateLimits, Mode=OneWay}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Texts.OfficialLimits, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Usage.OfficialLimitsMetadataText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

                    <ItemsControl Margin="0,4,0,0"
                                  ItemsSource="{Binding Usage.AntigravityLimitRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding RemainingText, Mode=OneWay}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar Margin="0,6,0,0"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding RemainingPercent, Mode=OneWay}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding ResetText, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Usage.HasFiveHourLimit, Mode=OneWay}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Texts.FiveHourSession, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Usage.FiveHourRemainingText, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Margin="0,6,0,0"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Usage.FiveHourRemainingPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Usage.FiveHourResetText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Usage.HasWeeklyLimit, Mode=OneWay}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Texts.Weekly, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Usage.WeeklyRemainingText, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Margin="0,6,0,0"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Usage.WeeklyRemainingPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Usage.WeeklyResetText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Margin="0,16,0,0"
                    Padding="20"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Texts.Settings, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                    <CheckBox Margin="0,14,0,0"
                              Content="{Binding Texts.ShowFloating, Mode=OneWay}"
                              IsChecked="{Binding Settings.IsFloatingPetEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,10,0,0"
                              Content="{Binding Texts.LaunchAtStartup, Mode=OneWay}"
                              IsChecked="{Binding Settings.IsLaunchAtStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding Settings.IsLaunchAtStartupAvailable, Mode=OneWay}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.RefreshInterval, Mode=OneWay}" />
                        <ComboBox Grid.Column="1"
                                  Width="120"
                                  ItemsSource="{Binding Settings.RefreshIntervalOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SelectedRefreshInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.LanguageLabel, Mode=OneWay}" />
                        <ComboBox Grid.Column="1" Width="140"
                                  ItemsSource="{Binding Settings.LanguageOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.LimitDisplay, Mode=OneWay}" />
                        <ComboBox Grid.Column="1" Width="140"
                                  ItemsSource="{Binding Settings.LimitDisplayOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SelectedLimitDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Margin="0,14,0,0" Content="{Binding Texts.LimitNotifications, Mode=OneWay}"
                              IsChecked="{Binding Settings.LimitNotificationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,8,0,0" Content="{Binding Texts.CompanionNotifications, Mode=OneWay}"
                              IsChecked="{Binding Settings.CompanionNotificationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.Warning, Mode=OneWay}" />
                        <Slider Grid.Column="1" Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.WarningThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.WarningThreshold, StringFormat={}{0:0}%, Mode=OneWay}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.Critical, Mode=OneWay}" />
                        <Slider Grid.Column="1" Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.CriticalThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.CriticalThreshold, StringFormat={}{0:0}%, Mode=OneWay}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.FloatingSize, Mode=OneWay}" />
                        <Slider Grid.Column="1" Minimum="48" Maximum="192" TickFrequency="8" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.FloatingPetSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.FloatingPetSize, StringFormat={}{0:0}px, Mode=OneWay}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts.AnimationQuality, Mode=OneWay}" />
                        <ComboBox Grid.Column="1" Width="140"
                                  ItemsSource="{Binding Settings.AnimationQualityOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SelectedAnimationQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Margin="0,8,0,0" Content="{Binding Texts.BubbleAlerts, Mode=OneWay}"
                              IsChecked="{Binding Settings.FloatingBubbleAlertsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,8,0,0" Content="{Binding Texts.UpdateNotifications, Mode=OneWay}"
                              IsChecked="{Binding Settings.UpdateNotificationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,14,0,0" Text="{Binding Texts.ProviderRoots, Mode=OneWay}" FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding Settings.ProviderRootOptions, Mode=OneWay}"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding Settings.SelectedRootProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,6,0,0" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding Settings.CustomRootText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Texts.CustomRootsHint, Mode=OneWay}" FontSize="10"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Settings.CustomRootStatus, Mode=OneWay}" FontSize="10" Foreground="#FFC62828" TextWrapping="Wrap" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,5"
                            Content="{Binding Texts.ResetFloatingPosition, Mode=OneWay}"
                            Command="{Binding Settings.ResetFloatingPetPositionCommand}" />
                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="{Binding Texts.About, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Support.AppName, Mode=OneWay}" FontSize="15" />
                    <TextBlock Text="{Binding Support.VersionText, Mode=OneWay}"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding Support.UpdateStatus, Mode=OneWay}"
                               FontSize="11" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Padding="10,5" Content="{Binding Texts.CheckForUpdates, Mode=OneWay}"
                                Command="{Binding Support.CheckForUpdatesCommand, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Padding="10,5" Content="{Binding Texts.DownloadUpdate, Mode=OneWay}"
                                Command="{Binding Support.OpenUpdateCommand, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Padding="10,5" Content="{Binding Texts.Later, Mode=OneWay}"
                                Command="{Binding Support.SkipUpdateCommand, Mode=OneWay}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Padding="10,5" Content="{Binding Texts.ExportSave, Mode=OneWay}"
                                Command="{Binding Support.ExportCommand, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Padding="10,5" Content="{Binding Texts.ImportSave, Mode=OneWay}"
                                Command="{Binding Support.ImportCommand, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Padding="10,5" Content="{Binding Texts.CopyDiagnostics, Mode=OneWay}"
                                Command="{Binding Support.CopyDiagnosticsCommand, Mode=OneWay}" />
                    </WrapPanel>
                    <Border Margin="0,10,0,0" Padding="9" Background="#20D97706" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Support.ShowUpdateBanner, Mode=OneWay}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Support.UpdateBannerText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding Settings.ErrorMessage, Mode=OneWay}"
                               Foreground="#FFC62828"
                               FontSize="11"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ErrorMessage, Mode=OneWay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="7"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="#20D97706"
                    BorderBrush="#FFD97706"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Usage.ErrorMessage, Mode=OneWay}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Usage.ErrorMessage, Mode=OneWay}"
                           Foreground="#FF9A4D00"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Texts.Shop, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <TextBlock Text="{Binding Texts.Shop, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Spend the tokens earned since installation. Purchases do not reduce growth."
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,0" Text="{Binding Texts.Balance, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Economy.BalanceText, Mode=OneWay}" FontSize="20" />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Economy.ShopProducts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding PriceText, Mode=OneWay}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Padding="12,5" Content="{Binding BuyText, Mode=OneWay}"
                                                IsEnabled="{Binding CanPurchase, Mode=OneWay}"
                                                Command="{Binding PurchaseCommand, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Economy.ResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Texts.Bag, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <TextBlock Text="{Binding Texts.Bag, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="Items persist across restarts."
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Economy.BagItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding StatusText, Mode=OneWay}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Padding="12,5" Content="{Binding UseText, Mode=OneWay}"
                                                IsEnabled="{Binding CanUse, Mode=OneWay}"
                                                Command="{Binding UseCommand, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Economy.ResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Texts.Collection, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts.Collection, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Padding="10,4" Content="{Binding Texts.FollowCurrent, Mode=OneWay}"
                                Command="{Binding Economy.ClearRepresentativeCommand, Mode=OneWay}" />
                    </Grid>
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Economy.CollectionEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  #" /><Run Text="{Binding SpeciesId, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,3,0,0">
                                                <Run Text="{Binding Rarity, Mode=OneWay}" /><Run Text=" · " />
                                                <Run Text="{Binding ShinyText, Mode=OneWay}" /><Run Text=" · " />
                                                <Run Text="{Binding Nature, Mode=OneWay, TargetNullValue=Unknown nature}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding RoleText, Mode=OneWay}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                            <TextBlock Text="{Binding CaughtText, Mode=OneWay}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Padding="10,4" Content="{Binding RepresentText, Mode=OneWay}"
                                                Command="{Binding SelectRepresentativeCommand, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Economy.ResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
